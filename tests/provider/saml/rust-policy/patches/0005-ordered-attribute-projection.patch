--- /dev/null
+++ b/src/api/response_claims.rs
@@ -0,0 +1,14 @@
+//! Trusted assertion data for the built-in IdP producer.
+use super::RespondSso;
+use crate::model::Attributes;
+
+impl RespondSso {
+    /// Emit exact scalar attributes using the built-in XML writer and signer.
+    /// Order, duplicate names, optional NameFormat and value groups are retained.
+    /// Cannot be combined with template-configured attributes or custom rendering.
+    /// These attributes do not establish authentication or authorization policy.
+    pub fn attributes(mut self, attributes: Attributes) -> Self {
+        self.attributes = Some(attributes);
+        self
+    }
+}
diff --git a/src/idp/attributes.rs b/src/idp/attributes.rs
new file mode 100644
index 0000000..a363b69
--- /dev/null
+++ b/src/idp/attributes.rs
@@ -0,0 +1,33 @@
+use crate::{error::SamlError, model::Attributes, xml::write::XmlWriter};
+
+pub(super) fn write(
+    writer: &mut XmlWriter,
+    prefix: &str,
+    attributes: &Attributes,
+) -> Result<(), SamlError> {
+    if attributes.as_slice().is_empty() {
+        return Ok(());
+    }
+    let statement = format!("{prefix}:AttributeStatement");
+    let attribute_name = format!("{prefix}:Attribute");
+    let value_name = format!("{prefix}:AttributeValue");
+    writer.start(&statement, &[]);
+    for attribute in attributes.as_slice() {
+        if attribute.name().is_empty() {
+            return Err(SamlError::Invalid(
+                "attribute Name must not be empty".into(),
+            ));
+        }
+        let mut fields = vec![("Name", attribute.name())];
+        if let Some(format) = attribute.name_format() {
+            fields.push(("NameFormat", format));
+        }
+        writer.start(&attribute_name, &fields);
+        for value in attribute.values() {
+            writer.text_element(&value_name, &[], value.as_str());
+        }
+        writer.end(&attribute_name);
+    }
+    writer.end(&statement);
+    Ok(())
+}
diff --git a/src/model/attribute_projection.rs b/src/model/attribute_projection.rs
new file mode 100644
index 0000000..60a8d30
--- /dev/null
+++ b/src/model/attribute_projection.rs
@@ -0,0 +1,68 @@
+use super::attributes::{Attribute, AttributeValue, Attributes};
+use crate::{error::SamlError, util::Value};
+
+pub(super) fn project(records: &Value) -> Result<Attributes, SamlError> {
+    let Value::Array(records) = records else {
+        return Err(invalid());
+    };
+    records
+        .iter()
+        .map(attribute)
+        .collect::<Result<Vec<_>, _>>()
+        .map(Attributes::new)
+}
+
+fn attribute(record: &Value) -> Result<Attribute, SamlError> {
+    let name = record
+        .get_str("Name")
+        .filter(|name| !name.is_empty())
+        .ok_or_else(invalid)?;
+    let format = match record.get("NameFormat") {
+        None => None,
+        Some(Value::Str(value)) => Some(value.clone()),
+        _ => return Err(invalid()),
+    };
+    let Some(Value::Array(values)) = record.get("values") else {
+        return Err(invalid());
+    };
+    let values = values
+        .iter()
+        .map(|value| match value {
+            Value::Str(value) => Ok(AttributeValue::new(value.clone())),
+            _ => Err(invalid()),
+        })
+        .collect::<Result<Vec<_>, _>>()?;
+    Ok(Attribute::new(name, format, values))
+}
+
+fn invalid() -> SamlError {
+    SamlError::Invalid("typed attributes require named records with scalar non-nil values".into())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn empty_records_are_a_complete_empty_projection() {
+        assert!(project(&Value::Array(Vec::new()))
+            .unwrap()
+            .as_slice()
+            .is_empty());
+    }
+
+    #[test]
+    fn unavailable_values_never_become_partial_or_empty_string_records() {
+        let record = |value| {
+            Value::Object(vec![
+                ("Name".into(), Value::Str("department".into())),
+                ("values".into(), Value::Array(vec![value])),
+            ])
+        };
+        assert!(project(&Value::Array(vec![
+            record(Value::Str("Engineering".into())),
+            record(Value::Null)
+        ]))
+        .is_err());
+    }
+}
diff --git a/src/xml/attribute_records.rs b/src/xml/attribute_records.rs
new file mode 100644
index 0000000..ff17209
--- /dev/null
+++ b/src/xml/attribute_records.rs
@@ -0,0 +1,60 @@
+//! Ordered attribute records from the same verified Assertion shortcut as the
+//! other assertion fields. The legacy name-keyed raw extraction stays intact.
+use super::dom::{self, Node, XmlLimits};
+use crate::{error::SamlError, util::Value};
+
+pub(crate) fn append(
+    extracted: &mut Value,
+    assertion: Option<&str>,
+    limits: XmlLimits,
+) -> Result<(), SamlError> {
+    let Some(assertion) = assertion else {
+        return Ok(());
+    };
+    let document = dom::parse_with_limits(assertion, limits)?;
+    if document.root.local_name != "Assertion" {
+        return Err(SamlError::Invalid(
+            "attribute projection requires an Assertion".into(),
+        ));
+    }
+    let rows = document
+        .root
+        .children
+        .iter()
+        .filter(|node| node.local_name == "AttributeStatement")
+        .flat_map(|node| &node.children)
+        .filter(|node| node.local_name == "Attribute")
+        .map(record)
+        .collect();
+    let Value::Object(fields) = extracted else {
+        return Err(SamlError::Invalid("expected extracted field object".into()));
+    };
+    fields.push(("attributeRecords".into(), Value::Array(rows)));
+    Ok(())
+}
+
+fn record(node: &Node) -> Value {
+    let mut fields: Vec<_> = ["Name", "NameFormat"]
+        .into_iter()
+        .filter_map(|name| {
+            node.attr(name)
+                .map(|value| (name.into(), Value::Str(value.into())))
+        })
+        .collect();
+    let values = node
+        .children
+        .iter()
+        .filter(|node| node.local_name == "AttributeValue")
+        .map(|value| {
+            // The typed scalar contract cannot silently flatten XML-valued or nil
+            // data into an ordinary string. Preserve its unsupported shape.
+            if !value.children.is_empty() || value.attr("nil").is_some() {
+                Value::Null
+            } else {
+                Value::Str(value.text.clone())
+            }
+        })
+        .collect();
+    fields.push(("values".into(), Value::Array(values)));
+    Value::Object(fields)
+}
