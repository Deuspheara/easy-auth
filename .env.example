# Local development only. Never reuse these credentials outside loopback development.
AUTH_DEVELOPMENT=true
AUTH_PUBLIC_URL=http://127.0.0.1:58417
AUTH_BIND=127.0.0.1:58417
AUTH_REALM_ID=71c39c4f-2fc2-4db6-8768-d4456f04304d # gitleaks:allow -- public example realm, not a credential
DATABASE_URL=postgres://auth:auth-development-only@127.0.0.1:59473/auth
# Compatibility default: run migrations at startup. For a separately migrated
# restricted runtime role, select verify; see docs/guides/database-roles.md.
AUTH_DATABASE_MIGRATIONS=run
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=auth@localhost.test
# Production: AUTH_DEVELOPMENT=false, HTTPS public URL, TLS SMTP (default 465).
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Development-only demonstration corpus; see docs/guides/passwords.md for production policy.
AUTH_PASSWORD_BLOCKLIST_FILE=docs/examples/password-blocklist-development.txt
