---
import Icon from "../Icon.astro";
import { ArrowUpRight01Icon } from "@hugeicons/core-free-icons";
import { sitePath } from "../../../scripts/site-path.mjs";
---

<section class="resources section-shell" aria-labelledby="resources-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">04 / DOCUMENTATION</p>
      <h2 id="resources-title">Documentation.</h2>
    </div>
    <a href={sitePath("/docs/")} class="text-link">
      All documentation <Icon icon={ArrowUpRight01Icon} size={14} />
    </a>
  </div>
  <div class="resource-grid">
    <a href={sitePath("/docs/getting-started/")}>
      <h3>
        Local development <Icon icon={ArrowUpRight01Icon} size={14} />
      </h3>
      <p>Run PostgreSQL, Mailpit and your first sign-in.</p>
    </a>
    <a href={sitePath("/docs/embedding/")}>
      <h3>
        Axum integration <Icon icon={ArrowUpRight01Icon} size={14} />
      </h3>
      <p>Compose the router and notification worker.</p>
    </a>
    <a href={sitePath("/docs/guides/server-configuration/")}>
      <h3>
        Configuration <Icon icon={ArrowUpRight01Icon} size={14} />
      </h3>
      <p>Set up HTTPS, SMTP and trusted providers.</p>
    </a>
  </div>
</section>
