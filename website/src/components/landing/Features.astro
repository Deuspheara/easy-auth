---
import { features } from "../../data/features";
---

<section
  id="features"
  class="features section-shell"
  aria-labelledby="features-title"
>
  <div class="section-heading">
    <div>
      <p class="eyebrow">02 / AUTHENTICATION</p>
      <h2 id="features-title">Choose a sign-in method.</h2>
    </div>
    <a class="text-link" href="/docs/features/">
      Feature status <span aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="feature-list">
    {features
      .filter((f) => f.featured)
      .map((feature, index) => (
        <a href={feature.href} class="feature-row">
          <span class="feature-number" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <h3>{feature.name}</h3>
          <p>{feature.description}</p>
          <span class="status-label">{feature.status}</span>
          <span class="row-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))}
  </div>
  <p class="section-note">
    Provider setup and release boundaries are documented per feature.
  </p>
</section>
