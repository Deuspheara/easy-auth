---
import Icon from "../Icon.astro";
import {
  ArrowRight01Icon,
  ArrowUpRight01Icon,
} from "@hugeicons/core-free-icons";
import { sitePath } from "../../../scripts/site-path.mjs";
import CodePanel from "./CodePanel.astro";
---

<section class="hero section-shell" aria-labelledby="hero-title">
  <div class="hero-meta">
    <span>RUST / AXUM / POSTGRESQL</span>
    <a href={sitePath("/docs/features/")}>
      Pre-release <Icon icon={ArrowUpRight01Icon} size={14} />
    </a>
  </div>
  <h1 id="hero-title">
    Authentication
    <br />
    <span>for Rust.</span>
  </h1>
  <p>
    Email links, passwords and provider sign-in.
    <br class="desktop-break" /> Embed in your Axum app or run as a standalone
    service.
  </p>
  <div class="hero-actions">
    <a class="button button-primary" href={sitePath("/docs/getting-started/")}>
      Get started <Icon icon={ArrowRight01Icon} size={14} />
    </a>
    <a
      class="button button-quiet"
      href="https://github.com/Deuspheara/easy-auth"
    >
      View source <Icon icon={ArrowUpRight01Icon} size={14} />
    </a>
  </div>
  <div class="hero-license">Open source. MIT OR Apache-2.0.</div>
</section>
<section class="integration section-shell" aria-labelledby="integration-title">
  <div class="integration-copy">
    <p class="eyebrow">01 / INTEGRATION</p>
    <h2 id="integration-title">Mount the router.</h2>
    <p>
      Mount the configured router in Axum. The same authentication core and
      PostgreSQL transactions also power the standalone server.
    </p>
    <a class="text-link" href={sitePath("/docs/embedding/")}>
      Read the integration guide <Icon icon={ArrowUpRight01Icon} size={14} />
    </a>
    <div class="source-note">
      <span aria-hidden="true">⌥</span>
      <span>
        Build from source.
        <br />
        Crates and APIs are pre-release.
      </span>
    </div>
  </div>
  <CodePanel />
</section>
