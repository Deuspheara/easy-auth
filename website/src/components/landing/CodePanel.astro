---
import Icon from "../Icon.astro";
import { ArrowUpRight01Icon, Copy01Icon } from "@hugeicons/core-free-icons";
import { sitePath } from "../../../scripts/site-path.mjs";
import { Code } from "astro:components";

const embedded = `use std::net::SocketAddr;
use tokio::net::TcpListener;

let app = easy_auth_server::configured_application().await?;
let notifications = easy_auth_server::notification_worker(app.auth.clone());
let listener = TcpListener::bind(app.bind).await?;

let result = axum::serve(
    listener,
    app.router.into_make_service_with_connect_info::<SocketAddr>(),
).await;

notifications.abort();
result?;`;
const standalone = `git clone https://github.com/Deuspheara/easy-auth.git
cd easy-auth

docker compose up -d --wait
cp .env.example .env
set -a; . ./.env; set +a

cargo run -p easy-auth-server --bin easy-auth`;
---

<div class="code-window" data-code-tabs>
  <div class="code-toolbar">
    <div role="tablist" aria-label="Integration example">
      <button
        role="tab"
        id="tab-embedded"
        aria-controls="panel-embedded"
        aria-selected="true"
      >
        Embed in Axum
      </button>
      <button
        role="tab"
        id="tab-standalone"
        aria-controls="panel-standalone"
        aria-selected="false"
        tabindex="-1"
      >
        Run the service
      </button>
    </div>
    <button class="copy-button" aria-label="Copy example" title="Copy example">
      <Icon icon={Copy01Icon} size={16} />
      <span class="sr-only" aria-live="polite"></span>
    </button>
  </div>
  <div
    id="panel-embedded"
    role="tabpanel"
    aria-labelledby="tab-embedded"
    tabindex="0"
  >
    <div class="code-filename">
      <span class="file-dot"></span> main.rs · excerpt <span>RUST</span>
    </div>
    <Code code={embedded} lang="rust" theme="github-dark" />
  </div>
  <div
    id="panel-standalone"
    role="tabpanel"
    aria-labelledby="tab-standalone"
    tabindex="0"
    hidden
  >
    <div class="code-filename">
      <span class="file-dot"></span> terminal <span>SHELL · LOCAL DEV</span>
    </div>
    <Code code={standalone} lang="shellscript" theme="github-dark" />
  </div>
  <div class="code-bottom">
    <span>Configuration from your trusted environment.</span>
    <a href={sitePath("/docs/embedding/")}>
      Full example <Icon icon={ArrowUpRight01Icon} size={14} />
    </a>
  </div>
</div>
