---
import Icon from "../Icon.astro";
import {
  ArrowUpRight01Icon,
  GithubIcon,
  Menu01Icon,
  ShieldKeyIcon,
  Sun03Icon,
} from "@hugeicons/core-free-icons";
import { sitePath } from "../../../scripts/site-path.mjs";
---

<header class="site-header">
  <a class="wordmark" href={sitePath("/")} aria-label="easy-auth home">
    <Icon icon={ShieldKeyIcon} size={28} />
    <span>easy-auth</span>
  </a>
  <button
    class="menu-toggle"
    aria-controls="site-navigation"
    aria-expanded="false"
    aria-label="Open navigation"
  >
    <Icon icon={Menu01Icon} size={20} />
  </button>
  <nav id="site-navigation" aria-label="Main navigation">
    <a href={sitePath("/#features")}>Features</a>
    <a href={sitePath("/docs/")}>Documentation</a>
    <a href={sitePath("/docs/features/")}>Status</a>
    <span class="nav-divider" aria-hidden="true"></span>
    <button
      class="theme-toggle"
      aria-label="Toggle color theme"
      title="Toggle color theme"
    >
      <Icon icon={Sun03Icon} size={18} />
    </button>
    <a class="github-link" href="https://github.com/Deuspheara/easy-auth">
      <Icon icon={GithubIcon} size={16} /> GitHub{" "}
      <Icon icon={ArrowUpRight01Icon} size={14} />
    </a>
  </nav>
</header>
