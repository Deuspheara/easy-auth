---
import Icon from "../Icon.astro";
import { ArrowUpRight01Icon } from "@hugeicons/core-free-icons";
import { sitePath } from "../../../scripts/site-path.mjs";
---

<section class="ownership section-shell" aria-labelledby="ownership-title">
  <div class="ownership-copy">
    <p class="eyebrow">03 / ARCHITECTURE</p>
    <h2 id="ownership-title">Identity and sessions.</h2>
    <p>
      Use easy-auth for identity and sessions. Keep roles, permissions and
      business rules in your application.
    </p>
    <a class="text-link" href={sitePath("/docs/")}>
      Architecture overview <Icon icon={ArrowUpRight01Icon} size={14} />
    </a>
  </div>
  <dl class="boundary-list">
    <div>
      <dt>Shared core</dt>
      <dd>
        Embedded and standalone modes use the same verification and session
        policy.
      </dd>
    </div>
    <div>
      <dt>Realm-scoped storage</dt>
      <dd>
        PostgreSQL transactions keep identities and authentication state scoped
        to a realm.
      </dd>
    </div>
    <div>
      <dt>Explicit identity links</dt>
      <dd>
        A matching email address does not automatically link provider accounts.
      </dd>
    </div>
  </dl>
</section>
