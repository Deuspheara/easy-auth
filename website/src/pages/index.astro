---
import Icon from "../components/Icon.astro";
import { ShieldKeyIcon } from "@hugeicons/core-free-icons";
import { sitePath } from "../../scripts/site-path.mjs";
import Header from "../components/landing/Header.astro";
import Hero from "../components/landing/Hero.astro";
import Features from "../components/landing/Features.astro";
import Architecture from "../components/landing/Architecture.astro";
import Resources from "../components/landing/Resources.astro";
import "../styles/landing.css";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Rust-first, self-hosted authentication. Embed in Axum or run a standalone service, with shared policy and PostgreSQL transactions."
    />
    <meta name="color-scheme" content="dark light" />
    <meta property="og:title" content="easy-auth — Authentication for Rust." />
    <meta property="og:type" content="website" />
    <meta
      property="og:description"
      content="Authentication that belongs in your Rust stack. Open source, self-hosted, built around Axum and PostgreSQL."
    />
    <title>easy-auth — Authentication for Rust.</title>
    <link rel="icon" type="image/svg+xml" href={sitePath("/favicon.svg")} />
    <script is:inline>
      try {
        const saved = localStorage.getItem("starlight-theme");
        document.documentElement.dataset.theme =
          saved === "light" || saved === "dark"
            ? saved
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
      } catch {
        /* The site remains usable when browser storage is unavailable. */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="page-grid">
      <Header />
      <main id="main">
        <Hero />
        <Features />
        <Architecture />
        <Resources />
      </main>
      <footer class="site-footer section-shell">
        <a class="wordmark" href={sitePath("/")}>
          <Icon icon={ShieldKeyIcon} size={28} />
          easy-auth
        </a>
        <p>Rust authentication. Open source.</p>
        <nav aria-label="Footer">
          <a href={sitePath("/docs/")}>Docs</a>
          <a href={sitePath("/docs/features/")}>Feature status</a>
          <a href="https://github.com/Deuspheara/easy-auth">Source</a>
        </nav>
        <small>
          Original code: MIT OR Apache-2.0.{" "}
          <a href={sitePath("/hugeicons-license.txt")}>
            Icons: Hugeicons Free (MIT).
          </a>
        </small>
      </footer>
    </div>
    <script>
      import "../scripts/landing";
    </script>
  </body>
</html>
